{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SecurityInfrastructureConfig",
    "type": "object",
    "required": [
        "project_id",
        "region",
        "security"
    ],
    "properties": {
        "project_id": {
            "type": "string",
            "minLength": 4,
            "description": "GCP Project ID for provisioning"
        },
        "region": {
            "type": "string",
            "description": "Default GCP region"
        },
        "tags": {
            "type": "object",
            "description": "Common key-value labels/tags for resource identification",
            "additionalProperties": {
                "type": "string"
            }
        },
        "security": {
            "type": "object",
            "required": [
                "service_accounts"
            ],
            "properties": {
                "service_accounts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "roles"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "pattern": "^[a-z]([-a-z0-9]{4,28}[a-z0-9])$",
                                "description": "Service account logical name (6-30 lowercase chars, digits, hyphens)"
                            },
                            "display_name": {
                                "type": "string",
                                "description": "Human-readable display name for the service account"
                            },
                            "description": {
                                "type": "string",
                                "description": "Purpose and description of the service account"
                            },
                            "roles": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string",
                                    "pattern": "^roles/[a-zA-Z0-9._-]+$"
                                },
                                "description": "List of least-privilege IAM roles assigned to the service account"
                            }
                        }
                    }
                }
            }
        }
    }
}