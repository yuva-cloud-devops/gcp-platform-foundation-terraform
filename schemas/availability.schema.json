{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AvailabilityInfrastructureConfig",
    "type": "object",
    "required": [
        "project_id",
        "region",
        "availability"
    ],
    "properties": {
        "project_id": {
            "type": "string",
            "minLength": 4,
            "description": "GCP Project ID for provisioning"
        },
        "region": {
            "type": "string",
            "description": "Default GCP region"
        },
        "state_bucket": {
            "type": "string",
            "description": "GCS bucket storing upstream Terraform remote states"
        },
        "tags": {
            "type": "object",
            "description": "Common key-value labels/tags applied to Load Balancer resources",
            "additionalProperties": {
                "type": "string"
            }
        },
        "availability": {
            "type": "object",
            "required": [
                "load_balancer"
            ],
            "properties": {
                "load_balancer": {
                    "type": "object",
                    "required": [
                        "name",
                        "backend"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 2,
                            "description": "Base name of the Global External Application Load Balancer"
                        },
                        "create_address": {
                            "type": "boolean"
                        },
                        "http_forward": {
                            "type": "boolean"
                        },
                        "ssl": {
                            "type": "boolean"
                        },
                        "https_redirect": {
                            "type": "boolean"
                        },
                        "backend": {
                            "type": "object",
                            "required": [
                                "protocol",
                                "port",
                                "port_name",
                                "health_check"
                            ],
                            "properties": {
                                "description": {
                                    "type": "string"
                                },
                                "protocol": {
                                    "type": "string",
                                    "enum": [
                                        "HTTP",
                                        "HTTPS",
                                        "HTTP2"
                                    ]
                                },
                                "port": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 65535
                                },
                                "port_name": {
                                    "type": "string"
                                },
                                "timeout_sec": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "enable_cdn": {
                                    "type": "boolean"
                                },
                                "connection_draining_timeout_sec": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "session_affinity": {
                                    "type": "string",
                                    "enum": [
                                        "NONE",
                                        "CLIENT_IP",
                                        "GENERATED_COOKIE"
                                    ]
                                },
                                "balancing_mode": {
                                    "type": "string",
                                    "enum": [
                                        "UTILIZATION",
                                        "RATE"
                                    ]
                                },
                                "max_utilization": {
                                    "type": "number",
                                    "minimum": 0.1,
                                    "maximum": 1.0
                                },
                                "capacity_scaler": {
                                    "type": "number",
                                    "minimum": 0.0,
                                    "maximum": 1.0
                                },
                                "target_migs": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "health_check": {
                                    "type": "object",
                                    "required": [
                                        "request_path",
                                        "port"
                                    ],
                                    "properties": {
                                        "request_path": {
                                            "type": "string"
                                        },
                                        "port": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "maximum": 65535
                                        },
                                        "check_interval_sec": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "timeout_sec": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "healthy_threshold": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "unhealthy_threshold": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "logging": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "log_config": {
                                    "type": "object",
                                    "properties": {
                                        "enable": {
                                            "type": "boolean"
                                        },
                                        "sample_rate": {
                                            "type": "number",
                                            "minimum": 0.0,
                                            "maximum": 1.0
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}